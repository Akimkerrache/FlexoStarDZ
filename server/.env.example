NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
# Public URL of this API (used in Swagger "servers")
PUBLIC_API_URL=http://localhost:5000

FRONTEND_URL=http://localhost:5173
# Comma-separated exact origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

MONGODB_URI=mongodb+srv://gcosmosweb:SdomPeJOlkJrVRiA@cluster0.r9h72mg.mongodb.net/flexo_star_dz_db?retryWrites=true&w=majority&appName=Cluster0

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_32
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=flexo_rt

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Max login attempts per window per IP+email
AUTH_RATE_LIMIT_MAX=10

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_REGION=auto
R2_PRESIGNED_URL_TTL_SECONDS=900
R2_MULTIPART_PART_SIZE_MB=10
MAX_UPLOAD_SIZE_MB=1024
MAX_SINGLE_UPLOAD_SIZE_MB=25
# Comma-separated MIME allowlist; empty = built-in default list (no executables)
ALLOWED_UPLOAD_MIME_TYPES=
# Hours after which unfinished uploads are aborted by `npm run files:cleanup`
ABANDONED_UPLOAD_HOURS=24

LOG_LEVEL=debug

# Open decisions (see docs/open-business-decisions.md)
JOB_NAME_REJECT_ARABIC=true
COLOR_COUNT_INCLUDES_PANTONE=false
DEFAULT_CURRENCY=DZD
# Minutes between automatic alert scans (0 disables)
ALERT_SCAN_INTERVAL_MINUTES=60

# One-time bootstrap only (npm run bootstrap:admin). Remove after provisioning.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
